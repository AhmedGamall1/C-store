{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // Strict type-checking is enabled for the data layer first. UI folders
  // (components, pages, router) still build via Vite; add them here as they
  // get typed.
  "include": [
    "src/vite-env.d.ts",
    "src/types",
    "src/api",
    "src/hooks",
    "src/lib",
    "src/providers"
  ]
}
